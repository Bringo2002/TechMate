    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "module": "esnext",
    "moduleResolution": "node",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "types": [
      "deno"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "supabase/functions/**/*.ts"
  ]
}